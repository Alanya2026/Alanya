% --------------------------------------------------------------------
%  Bandeau de volet — utilisé uniquement par le dossier assemblé.
%
%  Les cinq fonctionnalités partagent des titres de chapitre ("Modèle de
%  données", "Impact fichier par fichier"…). Mis bout à bout, ils deviennent
%  ambigus. Ce bandeau ouvre chaque bloc, met à jour l'en-tête courant, et
%  pose un repère dans la table des matières.
%
%  \volet{Numéro}{Titre}{Sous-titre}
% --------------------------------------------------------------------
%  Un \chapter ouvre de toute façon une page : un bandeau posé juste avant
%  laisserait une page presque vide. On en fait donc une vraie page
%  d'ouverture, qui sert aussi de repère de navigation dans un document long.
\newcommand{\volet}[3]{%
  \clearpage
  \setAlanyaDocTitre{#2}%
  \addtocontents{toc}{\protect\vspace{10pt}}%
  \addtocontents{toc}{\protect\noindent
    {\protect\sffamily\protect\bfseries\protect\color{AlanyaIndigoDark}
     VOLET~#1 --- #2}\protect\par\protect\vspace{3pt}}%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[AlanyaContainer]
      ([yshift=-6.2cm]current page.north west)
      rectangle ([yshift=-14.6cm]current page.north east);
    \fill[AlanyaIndigo]
      ([yshift=-6.2cm]current page.north west)
      rectangle ([yshift=-14.6cm, xshift=6pt]current page.north west);
  \end{tikzpicture}%
  \vspace*{7.1cm}\par\noindent
  {\sffamily\small\bfseries\color{AlanyaIndigoStrong} VOLET~#1}\\[10pt]
  {\sffamily\fontsize{30}{34}\selectfont\bfseries\color{AlanyaIndigoDark} #2}\\[12pt]
  {\sffamily\large\color{AlanyaGray} #3}%
  \clearpage
}

% --------------------------------------------------------------------
%  Badges Alanya dessinés en TikZ
%
%  Deux canaux visuels indépendants :
%    - le GLYPHE dit quoi   : coche = personne notable, panier = commerce,
%                             marque = compte officiel
%    - le CONTENANT dit si c'est vérifié : glyphe nu = déclaré par le compte,
%                             glyphe dans une pastille pleine = sceau Alanya
%
%  \badgeCoche{taille} \badgePanier{taille} \badgeMarque{taille}
%  \badgePastilleCoche{taille} \badgePastillePanier{taille}
%  où taille est un facteur d'échelle (1 = environ 12 pt, taille réelle
%  d'une ligne de conversation).
% --------------------------------------------------------------------

% Tracé de la coche, centré sur (0,0), rayon utile 0.5
\newcommand{\alanyaGlypheCoche}[1]{%
  \draw[#1, line width=0.16em, line cap=round, line join=round]
    (-0.26,0.02) -- (-0.06,-0.20) -- (0.28,0.22);}

% Tracé du panier : corps trapézoïdal PLEIN + anse.
% Le corps est rempli et non contourné : à 12 px, un filet de moins d'un pixel
% disparaît ou se remplit d'aliasing, alors qu'une silhouette pleine reste
% identifiable. La coche, elle, reste un tracé — c'est sa nature.
\newcommand{\alanyaGlyphePanier}[1]{%
  \fill[#1, line join=round]
    (-0.34,0.07) -- (0.34,0.07) -- (0.22,-0.28) -- (-0.22,-0.28) -- cycle;
  \draw[#1, line width=0.11em, line cap=round]
    (-0.17,0.09) arc[start angle=180, end angle=0, radius=0.17];}

% Marque Alanya : monogramme A, tracé explicitement plutôt que posé en nœud
% texte. Un \node centre la BOÎTE du texte, strut compris : la profondeur de
% police décale visuellement un « A » (qui n'a pas de jambage) vers le haut.
% Ce tracé est symétrique par construction — boîte x [-0,235 ; 0,235],
% y [-0,26 ; 0,26] — donc exactement centré sur (0,0), et identique au tracé
% SVG de la maquette.
%
% Le contre-poinçon (le triangle intérieur) est un second sous-chemin découpé
% par la règle pair-impair.
\newcommand{\alanyaGlypheMarque}[1]{%
  \fill[#1, even odd rule]
    (0,0.26) -- (0.235,-0.26) -- (0.125,-0.26) -- (0.083,-0.13)
      -- (-0.083,-0.13) -- (-0.125,-0.26) -- (-0.235,-0.26) -- cycle
    (0,0.115) -- (0.052,-0.045) -- (-0.052,-0.045) -- cycle;}

% Le SCEAU — contenant des badges vérifiés.
%
% Rosace à 12 lobes obtenue par r(theta) = R + A*cos(12*theta). Une pastille
% ronde ne se distingue d'aucune autre icône circulaire de l'interface ; le
% feston est identifiable au premier coup d'oeil, y compris à 12 px, et il est
% coûteux à imiter dans un nom d'affichage.
%
% Tracé échantillonné SANS `smooth` : l'interpolation lissée de TikZ dépasse sur
% une courbe oscillante et transforme les lobes en pointes d'étoile. Avec 288
% points (un tous les 1,25 degre) la ligne brisée est visuellement continue,
% y compris agrandie, et l'amplitude reste exactement celle demandée.
\newcommand{\alanyaSceau}[1]{%
  \fill[#1] plot[domain=0:358.75, samples=288]
    (\x:{0.44+0.05*cos(12*\x)}) -- cycle;}

% Les glyphes posés dans un sceau sont réduits : le rayon utile est le CREUX
% du feston (0,39), pas sa crête. Le panier, plus large que la coche, demande
% une réduction plus forte pour que son anse reste lisible.
\newcommand{\alanyaDansSceau}[2][0.85]{\begin{scope}[scale=#1]#2\end{scope}}

% Les badges sont dessinés à une taille de référence de 1 em puis mis à
% l'échelle par \scalebox : contrairement à l'option `scale` de TikZ,
% \scalebox met aussi à l'échelle les épaisseurs de trait, ce qui est
% indispensable pour juger la lisibilité à 12 px.
\newcommand{\alanyaBadgeBoite}[2]{%
  \scalebox{#1}{\begin{tikzpicture}[x=1em, y=1em, baseline=-0.35ex]#2\end{tikzpicture}}}

\newcommand{\badgeCoche}[1][1]{%
  \alanyaBadgeBoite{#1}{\alanyaGlypheCoche{AlanyaIndigo}}}

\newcommand{\badgePanier}[1][1]{%
  \alanyaBadgeBoite{#1}{\alanyaGlyphePanier{AlanyaGray}}}

\newcommand{\badgePastilleCoche}[1][1]{%
  \alanyaBadgeBoite{#1}{%
    \alanyaSceau{AlanyaIndigo}
    \alanyaDansSceau{\alanyaGlypheCoche{white}}}}

\newcommand{\badgePastillePanier}[1][1]{%
  \alanyaBadgeBoite{#1}{%
    \alanyaSceau{AlanyaIndigo}
    \alanyaDansSceau[0.78]{\alanyaGlyphePanier{white}}}}

\newcommand{\badgeMarque}[1][1]{%
  \alanyaBadgeBoite{#1}{%
    \alanyaSceau{AlanyaOfficiel}
    \alanyaDansSceau{\alanyaGlypheMarque{white}}}}

% Sceau nu, pour illustrer la forme dans le texte.
\newcommand{\badgeSceauNu}[1][1]{%
  \alanyaBadgeBoite{#1}{\alanyaSceau{AlanyaIndigo}}}

