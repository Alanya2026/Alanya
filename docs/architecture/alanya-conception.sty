% Cadre de remplacement si l'image n'est pas encore produite.
\newcommand{\imageOuCadre}[3]{%
  \IfFileExists{#1}{%
    \includegraphics[width=#2]{#1}%
  }{%
    \fbox{\begin{minipage}[c][4.2cm][c]{#2}%
      \centering\sffamily\color{AlanyaGray}%
      \textbf{[ Maquette à produire ]}\\[6pt]%
      \small #3%
    \end{minipage}}%
  }%
}

