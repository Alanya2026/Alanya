<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Alanya</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Alanya</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>remote-notification</string>
			<string>voip</string>
			<!-- Trajets de confiance. Sans ce mode, iOS coupe les mises à jour de
			     position dès que l'application quitte le premier plan — c'est-à-dire
			     au moment précis où le suivi sert. La pastille bleue reste visible
			     (showBackgroundLocationIndicator) : on ne masque jamais le fait
			     qu'on suit une position.
			     ⚠ Exige un profil de provisionnement adapté et une justification à
			     la revue Apple : « partage de position en direct, limité à un trajet
			     que l'utilisateur a explicitement démarré ». -->
			<string>location</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>NSCameraUsageDescription</key>
		<string>Alanya a besoin d'accéder à votre caméra pour les appels vidéo, prendre des photos et enregistrer des vidéos.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Alanya a besoin d'accéder à votre microphone pour les appels audio/vidéo et enregistrer des vidéos avec son.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Alanya enregistre les photos et vidéos reçues dans l'album Alanya.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Alanya enregistre les photos et vidéos reçues dans l'album Alanya.</string>
		<!-- Ces phrases sont lues telles quelles par l'utilisateur ET par la revue
		     Apple : elles doivent décrire TOUS les usages. Celle d'origine ne
		     mentionnait que le partage ponctuel en conversation, alors que le volet
		     des trajets suit la position en continu — un motif de rejet, et surtout
		     une information incomplète donnée au moment où l'on décide. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Alanya utilise votre position pour partager un lieu dans une conversation, et pour suivre un trajet de confiance que vous avez démarré.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Pendant un trajet de confiance, Alanya partage votre position avec les proches que vous avez choisis, même écran verrouillé. Le partage s'arrête à la fin du trajet. Jamais avant, jamais après.</string>
		<key>NSFaceIDUsageDescription</key>
		<string>Alanya utilise Face ID ou Touch ID pour verrouiller l'accès à l'application.</string>
		<key>UIFileSharingEnabled</key>
		<true/>
		<key>LSSupportsOpeningDocumentsInPlace</key>
		<true/>
		<key>AppGroupId</key>
		<string>$(CUSTOM_GROUP_ID)</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>ShareMedia-$(PRODUCT_BUNDLE_IDENTIFIER)</string>
				</array>
			</dict>
			<!-- Bouton « Ouvrir dans Alanya » de la page d'accueil d'un code QR.
			     Les Universal Links (lien https ouvrant l'app directement)
			     exigent un Team ID Apple et l'entitlement associated-domains,
			     absents du projet : ce schéma est donc le seul chemin sur iOS
			     pour l'instant. -->
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.alanya237.alanya.qr</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>alanya</string>
				</array>
			</dict>
		</array>
	</dict>
</plist>
